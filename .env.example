# Copiá este archivo como .env.local y completalo con la config web de Firebase
# (Firebase Console → Configuración del proyecto → Tus apps → Web).
# .env.local no se versiona. En GitHub Actions estos valores salen de los secrets del repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: site key de reCAPTCHA v3. Si queda vacía, App Check no se activa.
VITE_FIREBASE_APPCHECK_SITE_KEY=
